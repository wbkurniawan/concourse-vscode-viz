{
  "name": "concourse-vscode-viz",
  "displayName": "Concourse Pipeline Visualizer",
  "description": "Preview Concourse CI pipelines in VS Code",
  "version": "0.1.0",
  "publisher": "KrakatoaCaldera",
  "repository": {
    "type": "git",
    "url": "https://github.com/wbkurniawan/concourse-vscode-viz"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "concourse",
    "pipeline",
    "visualization",
    "yaml",
    "ci"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#2a2a2a",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:yaml",
    "workspaceContains:**/*.yml",
    "workspaceContains:**/*.yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "concourse-vscode-viz.showPipelinePreview",
        "title": "Show Concourse Pipeline Preview",
        "icon": "$(open-preview)"
      }
    ],
    "languages": [
      {
        "id": "yaml",
        "extensions": [
          ".yml",
          ".yaml"
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "concourse-vscode-viz.showPipelinePreview",
          "when": "resourceExtname == .yml || resourceExtname == .yaml",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run build:webview",
    "watch": "tsc -watch -p ./",
    "build:webview": "esbuild ./src/webview/index.ts --bundle --outfile=out/webview/bundle.js",
    "watch:webview": "esbuild ./src/webview/index.ts --bundle --outfile=out/webview/bundle.js --watch",
    "package": "vsce package",
    "install-local": "vsce package && code --install-extension concourse-vscode-viz-0.1.0.vsix"
  },
  "dependencies": {
    "d3": "^7.8.5",
    "js-yaml": "^4.1.0",
    "underscore": "^1.13.6"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^16.11.7",
    "@types/underscore": "^1.11.18",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^5.42.0",
    "@typescript-eslint/parser": "^5.42.0",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.25.3",
    "eslint": "^8.26.0",
    "typescript": "^5.2.2"
  }
}
